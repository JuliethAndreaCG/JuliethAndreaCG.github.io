<?xml version="1.0" encoding="UTF-8"?>
<!--
  PsicoJuliethCG - Esencia&Mental · Sitemap XML
  https://juliethandreacg.github.io/sitemap.xml

  Best practices applied (Google Search Central, schema.org):
  - Solo URLs únicas: NO incluimos anchors (#about, #skills, etc.).
    Google los deduplica a la URL base y su inclusion genera ruido.
  - <lastmod> en ISO 8601 con offset horario (más preciso que solo fecha).
  - <changefreq> y <priority> son hints — Google los ignora en muchos casos
    pero se mantienen por compatibilidad con otros crawlers (Bing, Yandex).
  - Hreflang declarado con <xhtml:link> en cada URL.
  - Extensiones de Google (image, video) embebidas en el <url> raíz
    para evitar sitemaps auxiliares cuando el contenido es pequeño.
  - Máximo 50.000 URLs y 50 MB (límite de protocolo). Tenemos 2.
  - No listamos páginas no-crawlable, redirects, ni 404s.

  Última actualización: 2026-10-15
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml"
        xmlns:image="http://www.google.com/schemas/sitemap-image/1.1"
        xmlns:video="http://www.google.com/schemas/sitemap-video/1.1">

  <!--
    Landing principal (SPA).
    Las secciones internas (#about, #skills, #approach, #experience,
    #faq, #resources, #contact) son fragmentos de esta misma URL y NO
    requieren entradas separadas en el sitemap.
  -->
  <url>
    <loc>https://juliethandreacg.github.io/</loc>
    <lastmod>2026-10-15T15:00:00-05:00</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>

    <!-- i18n: español por defecto, inglés vía query param -->
    <xhtml:link rel="alternate" hreflang="es" href="https://juliethandreacg.github.io/"/>
    <xhtml:link rel="alternate" hreflang="es-CO" href="https://juliethandreacg.github.io/"/>
    <xhtml:link rel="alternate" hreflang="en" href="https://juliethandreacg.github.io/?lang=en"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="https://juliethandreacg.github.io/"/>

    <!-- Imagen Open Graph principal (1200x630) -->
    <image:image>
      <image:loc>https://juliethandreacg.github.io/og-banner.jpg</image:loc>
      <image:title>PsicoJuliethCG - Esencia&amp;Mental</image:title>
      <image:caption>Psicóloga clínica y organizacional en Ginebra, Valle del Cauca. Atención online y presencial.</image:caption>
    </image:image>

    <!-- Retrato profesional (E-E-A-T: author photo) -->
    <image:image>
      <image:loc>https://juliethandreacg.github.io/foto.jpg</image:loc>
      <image:title>Julieth Andrea Caicedo - Psicóloga</image:title>
      <image:caption>Retrato profesional de la psicóloga Julieth Andrea Caicedo Goyeneche.</image:caption>
    </image:image>

    <!--
      Video de marca: el sitio enlaza al canal de Facebook donde se
      publican videos educativos de salud mental. No alojamos archivos
      de video propios, por lo que player_loc apunta al canal.
    -->
    <video:video>
      <video:thumbnail_loc>https://juliethandreacg.github.io/foto.jpg</video:thumbnail_loc>
      <video:title>PsicoJuliethCG - Videos sobre salud mental</video:title>
      <video:description>Contenido educativo sobre ansiedad, autoestima, regulación emocional, terapia psicológica y bienestar. Publicado en el canal de Facebook PsicoJuliethCG.</video:description>
      <video:content_loc>https://www.facebook.com/PsicoJuliethCG/videos/</video:content_loc>
      <video:player_loc allow_embed="no" autoplay="no">https://www.facebook.com/PsicoJuliethCG/videos/</video:player_loc>
      <video:duration>180</video:duration>
      <video:view_count>0</video:view_count>
      <video:publication_date>2026-10-15T15:00:00-05:00</video:publication_date>
      <video:family_friendly>yes</video:family_friendly>
      <video:tag>psicóloga</video:tag>
